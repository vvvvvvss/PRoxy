DATABASE_URL=postgres://app:app@localhost:5432/ghagent
GITHUB_TOKEN=          # fine-grained PAT: sandbox repo only; Issues + Contents + Pull requests (read and write)

# ---- Real GitHub writes: both OFF by default ----
# With these unset, "Approve" only records your decision. Nothing is pushed.
ALLOW_GITHUB_WRITES=false
WRITABLE_REPOS=vvvvvvss/sandbox     # comma-separated owner/name list the agent may push branches to

# ---- LLM: pick ONE block ----
# A) Anthropic (needs prepaid credit at console.anthropic.com)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-sonnet-5-5

# Optional: if the main model stays overloaded after 5 retries, try this one once (check the current model name in the provider docs)
# LLM_FALLBACK_MODEL=gemini-2.5-flash-lite

# B) Free option: Google Gemini via its OpenAI-compatible endpoint (key from aistudio.google.com)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=
# LLM_MODEL=gemini-2.5-flash

# C) Free option: Groq (key from console.groq.com)
# LLM_PROVIDER=openai
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=llama-3.3-70b-versatile
